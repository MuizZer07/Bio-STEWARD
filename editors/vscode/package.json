    "configuration": {
      "title": "Bio-STEWARD",
      "properties": {
        "bioSteward.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path of the `steward` program to use. Empty: look on `PATH`, then in the pipx and uv tool folders. A workspace cannot set this, and a repository-local `.venv` is never picked automatically."
        },
        "bioSteward.gate": {
          "type": "string",
          "default": "default",
          "scope": "resource",
          "markdownDescription": "The gate whose eligibility the status bar shows."
        },
        "bioSteward.check.onSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Run `steward check` again after a file is saved (debounced, one run at a time)."
        },
        "bioSteward.report.location": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "repository",
            "extension"
          ],
          "markdownEnumDescriptions": [
            "`.steward/report.json` when `.steward/` is git-ignored, otherwise the extension's storage.",
            "Always `.steward/report.json` in the repository.",
            "Always the extension's own storage; nothing is written to the repository."
          ],
          "markdownDescription": "Where the report of a check run is written."
        },
        "bioSteward.diagnostics.unknownSeverity": {
          "type": "string",
          "default": "information",
          "scope": "resource",
          "enum": [
            "information",
            "warning"
          ],
          "markdownDescription": "Severity in the Problems panel for results with status UNKNOWN."
        },
        "bioSteward.timeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 1,
          "scope": "machine",
          "markdownDescription": "Seconds before a CLI run is stopped."
        },
        "bioSteward.registry": {
          "type": "string",
          "default": "respect",
          "scope": "machine",
          "enum": [
            "respect",
            "disable"
          ],
          "markdownEnumDescriptions": [
            "Keep the CLI's default: `steward check` records the checkout in its machine registry.",
            "Run the CLI with `STEWARD_NO_REGISTRY=1`, so nothing is recorded in the registry."
          ],
          "markdownDescription": "Whether CLI runs from the extension record the checkout in the CLI's machine registry."
        },
        "bioSteward.whereAmI.showOnReopen": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show **Bio-STEWARD: Where am I?** once when a project is opened again after more than `#bioSteward.whereAmI.reopenAfterDays#` days. Turn off to show it only on request."
        },
        "bioSteward.whereAmI.reopenAfterDays": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "scope": "window",
          "markdownDescription": "Days away after which reopening a project shows **Where am I?** (with `#bioSteward.whereAmI.showOnReopen#` on). The last open is kept by the extension, never in the repository."
        },
        "bioSteward.tokens.claudeLogs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Claude Code session logs that `steward tokens report` reads for the **Tokens** panel: absolute paths of log files or folders (a folder gives its newest `.jsonl` and `.json` files, at most 50). Usually `~/.claude/projects/<this project's folder>`. A workspace cannot set this. The CLI prints counts only; nothing leaves this machine."
        },
        "bioSteward.tokens.codexLogs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Codex session logs that `steward tokens report` reads for the **Tokens** panel: absolute paths of log files or folders (a folder gives its newest `.jsonl` and `.json` files, at most 50). Usually `~/.codex/sessions`. A workspace cannot set this. The CLI prints counts only; nothing leaves this machine."
        },
        "bioSteward.tokens.geminiLogs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Gemini CLI session logs that `steward tokens report` reads for the **Tokens** panel: absolute paths of log files or folders (a folder gives its newest `.jsonl` and `.json` files, at most 50). Usually `~/.gemini/tmp/<this project's hash>`. A workspace cannot set this. The CLI prints counts only; nothing leaves this machine."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "guidedInit",
        "title": "Set up a Bio-STEWARD project",
        "description": "Initialize an open folder with the steward CLI.",
        "when": "isWorkspaceTrusted && !bioSteward.hasProject",
        "steps": [
          {
            "id": "initialize",
            "title": "Initialize your project",
            "description": "Choose goals, a profile and optional Agent Skills. Review the CLI preview before confirming. Bio-STEWARD then runs the first check and opens the Overview.\n[Initialize Project](command:bioSteward.initialize)",
            "media": {
              "image": "media/shield.svg",
              "altText": "Bio-STEWARD shield"
            },
            "completionEvents": [
              "onContext:bioSteward.initCompleted"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc --noEmit -p tsconfig.json && node esbuild.mjs --production",
    "cli:install": "node scripts/cli-install.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.mjs",
    "lint": "eslint .",
    "compile:tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile:tests && mocha",
    "test:host": "npm run build && npm run compile:tests && vscode-test",
    "check": "npm run lint && npm run build && npm run test:unit",
    "figures": "npm run compile:tests && node scripts/figures.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.7",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
