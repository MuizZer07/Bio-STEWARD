  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Order: plans by recorded date, newest first, then by natural ID, highest first. Undated plans come last. Sprint tasks use their latest ledger event, with natural ID as a fallback. Milestone progress retains the order used by timeline.",
  "properties": {
    "history": {
      "enum": [
        "available",
        "unavailable",
        "shallow",
        "partial"
      ],
      "title": "History",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "plans": {
      "items": {
        "discriminator": {
          "mapping": {
            "milestone": "#/$defs/MilestonePlan",
            "release": "#/$defs/ReleasePlan",
            "roadmap": "#/$defs/RoadmapPlan",
            "sprint": "#/$defs/SprintPlan"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RoadmapPlan"
          },
          {
            "$ref": "#/$defs/ReleasePlan"
          },
          {
            "$ref": "#/$defs/SprintPlan"
          },
          {
            "$ref": "#/$defs/MilestonePlan"
          }
        ]
      },
      "title": "Plans",
      "type": "array"
    },
    "schema": {
      "const": "steward.plans/0.1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plans",
    "history",
    "notes"
  ],
  "title": "Plans",
  "type": "object"
